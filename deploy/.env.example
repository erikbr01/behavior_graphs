# Copy to .env before `docker compose up`.
#
# Generate a password hash:
#   python3 -c "import hashlib; print(hashlib.sha256(b'yourpassword').hexdigest())"

# ── Data root ───────────────────────────────────────────────────────────────
# Holds runs/, sweeps/ and rollouts/. Bind-mounted at /data in both containers.
DATA_PATH=./data

# ── Host user owning that data ──────────────────────────────────────────────
# Without these the containers run as root and write root-owned files into the
# bind mount. Set to `id -u` / `id -g`.
APP_UID=1000
APP_GID=1000

# ── App passwords (optional — blank = open access) ──────────────────────────
APP_PASSWORD_SHA256=
SURVEY_PASSWORD_SHA256=
REVIEWER_PASSWORD_SHA256=

# ── Which study the participant URL serves ──────────────────────────────────
# A variant id from configs/viz/study_variants/.
STUDY_VARIANT=three_stage_v1
# Only needed when the variant defines more than one group; defaults to the first.
# STUDY_VARIANT_GROUP=randomized

# The participant route stays closed unless this is exactly "1".
STUDY_ACCEPTING_RESPONSES=0

# ── Which datasets the demo's selector lists ────────────────────────────────
# A group under configs/data/. Empty lists every discovered run.
BEHAVIOR_GRAPHS_DISPLAY_DATA=visualize

# ── Video proxies ───────────────────────────────────────────────────────────
# Height in pixels of the web-sized transcodes the apps serve.
BEHAVIOR_GRAPHS_PROXY_HEIGHT=360

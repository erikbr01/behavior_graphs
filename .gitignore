# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv
.pytest_cache/
.ruff_cache/

# Experiment artifacts
data
!configs/data
!configs/progress_estimation/data
runs/
outputs/
multirun/
wandb/

# Editors / OS
.vscode/
.idea/
.DS_Store
deploy/.env
.env


# progress-estimation benchmark outputs (regenerable; not versioned)
analysis/out/

# Local media-proxy cache (behavior_graphs.viz.media)
.mediacache/
.streamlit/cache/

# hydra job log written by scripts/run_sweep.py into the launch dir
run_sweep.log
*.nohup
nohup.out

# A literal `${oc.env:DATA_PATH}/` directory appears whenever something runs
# with DATA_PATH unset and hydra's interpolation reaches the filesystem
# unresolved. It is always a mistake, never data.
${oc.env:*}

# Progress-estimation benchmark outputs: per-dataset metrics/curves written by
# scripts/run_progress_bench.py and the two sweep drivers (docs/progress_estimation.md).
progress_bench/
progress_allds/
progress_allmethods/
progress_consolidated/
*_curves.npz

# Study responses — participant data, and the default dir a local run writes to
study_results/

# Local scratch: the pipeline stage cache, several GB of it.
cache/

# Timestamped copies made by hand before a deploy change.
deploy/*.bak-*

# The reproduction data bundle, as reproduce/make_data_bundle.sh writes it.
/data_bundle/
/data_bundle.tar.gz

# Written into the repo root by unsloth when a ROBOMETER/TOPReward baseline
# runs from third_party/robometer's venv. Generated torch-compile shims.
unsloth_compiled_cache/
